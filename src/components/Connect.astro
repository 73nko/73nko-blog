---
import { socialLinks } from '../data/social';
import { CAL_BOOKING_URL, CONTACT_EMAIL } from '../data/links';
import { Github, Linkedin, Twitter, Mail, Calendar } from 'lucide-astro';

const iconMap: Record<string, any> = {
  github: Github,
  linkedin: Linkedin,
  twitter: Twitter,
  mail: Mail,
};

// Section nav anchor is #contact; exclude email from the trailing social row
// (it's already shown in plain text + as the mailto button).
const trailingSocials = socialLinks.filter((link) => link.icon !== 'mail');
---

<section id="contact" class="relative px-6 py-24 sm:px-12 lg:px-20">
  <div class="mx-auto w-full max-w-[1100px]">
    <!-- Section header -->
    <div class="mb-9 border-b border-[--sp-ink-line] pb-4">
      <span class="font-mono text-[13px] font-medium tracking-[2px] text-sp-magenta">05</span>
      <h2 class="mt-1 text-4xl font-bold tracking-[-0.6px]">
        Work <span class="text-sp-turquoise-hi">with me</span>
      </h2>
    </div>

    <div class="relative overflow-hidden rounded-2xl border border-[--sp-ink-line] bg-sp-ink px-6 py-12 sm:px-10 sm:py-14">
      <!-- Bottom glow — mirrors hero top glow -->
      <div class="pointer-events-none absolute -bottom-24 left-1/2 h-[300px] w-[400px] -translate-x-1/2 rounded-full bg-sp-magenta/[0.08] blur-[100px]" aria-hidden="true"></div>

      <p class="relative mb-7 max-w-[640px] text-[15px] leading-relaxed text-sp-fg/85">
        The fastest way to gauge fit is a 20-minute intro call. I'll ask about your project, you'll ask about my approach. No commitment.
      </p>

      <div class="relative mb-8 flex flex-wrap gap-3">
        <a
          href={CAL_BOOKING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-sp-magenta px-5 py-2.5 font-mono text-xs font-medium tracking-[0.5px] text-sp-dusk transition-all duration-200 hover:bg-sp-magenta-hi"
        >
          <Calendar size={14} />
          Book an intro call →
        </a>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sp-turquoise-hi/25 bg-sp-turquoise-hi/[0.12] px-5 py-2.5 font-mono text-xs font-medium tracking-[0.5px] text-sp-turquoise-hi transition-all duration-200 hover:bg-sp-turquoise-hi/20"
        >
          <Mail size={14} />
          {CONTACT_EMAIL}
        </a>
      </div>

      <p class="relative mb-6 max-w-[640px] text-[14px] leading-relaxed text-[--sp-muted]">
        For everything else (collaborations, content, speaking), email is best.
      </p>

      <div class="relative flex flex-wrap gap-3">
        {trailingSocials.map((link) => {
          const Icon = iconMap[link.icon];
          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-sp-turquoise-hi/20 bg-sp-turquoise-hi/[0.06] text-sp-rosegold/80 transition-all duration-200 hover:border-sp-turquoise-hi/40 hover:bg-sp-turquoise-hi/15 hover:text-sp-turquoise-hi"
            >
              {Icon && <Icon size={16} />}
            </a>
          );
        })}
      </div>
    </div>

    {/* Footer */}
    <footer class="mt-16 border-t border-[--sp-ink-line] pt-6 text-center font-mono text-xs text-[--sp-faint]">
      <p>&copy; {new Date().getFullYear()} Alejandro Pérez.</p>
    </footer>
  </div>
</section>
