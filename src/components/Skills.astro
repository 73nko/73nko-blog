---
import { investingIn, productionExperience } from '../data/skills';
---

<section id="skills" class="relative px-6 py-24 sm:px-12 lg:px-20">
  <div class="mx-auto w-full max-w-[1100px]">
    <!-- Section header -->
    <div class="mb-9 border-b border-[--vh-hairline] pb-4">
      <span class="font-mono text-[13px] font-medium tracking-[2px] text-vh-orchid">04</span>
      <h2 class="mt-1 text-4xl font-bold tracking-[-0.6px]">
        What I'm <span class="text-vh-ice">working with</span>
      </h2>
    </div>

    <p class="mb-8 max-w-[720px] text-[15px] leading-relaxed text-[--vh-muted]">
      Two lists, kept honest. What I'm investing time in right now, and what I'd reach for in production tomorrow without a second thought.
    </p>

    <div class="grid gap-4 lg:grid-cols-2">
      <!-- Currently investing in -->
      <div class="skill-card glass relative overflow-hidden rounded-xl p-5 sm:p-6">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-vh-ice to-transparent opacity-70"></div>
        <span class="font-mono text-[10px] font-medium uppercase tracking-[2px] text-vh-ice">
          {investingIn.name}
        </span>
        <p class="mt-2 text-[12px] text-[--vh-faint]">Where I'm spending my learning hours this quarter.</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {investingIn.skills.map((skill) => (
            <span class="rounded-md border border-vh-ice/[0.18] bg-vh-ice/[0.08] px-2.5 py-1 font-mono text-[11px] text-vh-lilac">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- Production experience -->
      <div class="skill-card glass relative overflow-hidden rounded-xl p-5 sm:p-6">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-vh-orchid to-transparent opacity-70"></div>
        <span class="font-mono text-[10px] font-medium uppercase tracking-[2px] text-vh-orchid">
          {productionExperience.name}
        </span>
        <p class="mt-2 text-[12px] text-[--vh-faint]">What I've shipped, owned, and operated in real systems.</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {productionExperience.skills.map((skill) => (
            <span class="rounded-md border border-vh-orchid/[0.18] bg-vh-orchid/[0.08] px-2.5 py-1 font-mono text-[11px] text-vh-lilac">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
