---
import { socialLinks } from '../data/social';
import { CAL_BOOKING_URL, CONTACT_EMAIL } from '../data/links';
import { Github, Linkedin, Twitter, Mail } from 'lucide-astro';

const iconMap: Record<string, any> = {
  github: Github,
  linkedin: Linkedin,
  twitter: Twitter,
  mail: Mail,
};

const trailingSocials = socialLinks.filter((link) => link.icon !== 'mail');
---

<section id="contact" class="relative px-6 py-24 sm:px-12 lg:px-20">
  <div class="mx-auto w-full max-w-[1100px]">
    <!-- Section header -->
    <div class="mb-9 border-b border-[--vh-hairline] pb-4">
      <span class="font-mono text-[13px] font-medium tracking-[2px] text-vh-orchid">05</span>
      <h2 class="mt-1 text-4xl font-bold tracking-[-0.6px]">
        Get in <span class="text-vh-ice">touch</span>
      </h2>
    </div>

    <div class="glass relative overflow-hidden rounded-2xl px-6 py-12 sm:px-10 sm:py-14">
      <!-- Bottom glow — mirrors hero top glow -->
      <div class="pointer-events-none absolute -bottom-24 left-1/2 h-[300px] w-[400px] -translate-x-1/2 rounded-full bg-vh-orchid/[0.10] blur-[100px]" aria-hidden="true"></div>

      <p class="relative mb-7 max-w-[640px] text-[15px] leading-relaxed text-vh-star/85">
        Best ways to reach me: email or LinkedIn. Roles, collaborations, and technical conversations all welcome.
      </p>

      <div class="relative mb-8 flex flex-wrap gap-3">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-vh-orchid px-5 py-2.5 font-mono text-xs font-medium tracking-[0.5px] text-vh-night transition-all duration-200 hover:bg-vh-lilac"
        >
          <Mail size={14} />
          {CONTACT_EMAIL}
        </a>
        <a
          href="https://www.linkedin.com/in/alejandroperez"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-vh-ice/25 bg-vh-ice/[0.12] px-5 py-2.5 font-mono text-xs font-medium tracking-[0.5px] text-vh-ice transition-all duration-200 hover:bg-vh-ice/20"
        >
          <Linkedin size={14} />
          LinkedIn
        </a>
      </div>

      <div class="relative flex flex-wrap gap-3">
        {trailingSocials.map((link) => {
          const Icon = iconMap[link.icon];
          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-vh-ice/20 bg-vh-ice/[0.06] text-vh-lilac/80 transition-all duration-200 hover:border-vh-ice/40 hover:bg-vh-ice/15 hover:text-vh-ice"
            >
              {Icon && <Icon size={16} />}
            </a>
          );
        })}
      </div>

      <p class="relative mt-8 text-[12px] text-[--vh-faint]">
        Open to short coffee chats and mentoring conversations:
        <a
          href={CAL_BOOKING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 underline decoration-vh-ice/30 underline-offset-4 transition-colors hover:text-vh-ice hover:decoration-vh-ice"
        >
          book a 30-min coffee chat →
        </a>
      </p>
    </div>

    {/* Footer */}
    <footer class="mt-16 border-t border-[--vh-hairline] pt-6 text-center font-mono text-xs text-[--vh-faint]">
      <p>&copy; {new Date().getFullYear()} Alejandro Pérez.</p>
    </footer>
  </div>
</section>
